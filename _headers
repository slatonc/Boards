/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data:; media-src 'self'; frame-src 'self'; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests

/book-intro
  X-Robots-Tag: noindex

/book-intro.html
  X-Robots-Tag: noindex

/404.html
  X-Robots-Tag: noindex
